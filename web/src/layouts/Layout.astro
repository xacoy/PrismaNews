---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { href } from '../lib/format';
import { data } from '../lib/data';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
interface Props { title: string; description?: string }
const { title, description = 'Prisma agrupa los titulares de distintos medios que hablan de lo mismo y muestra quién cubre cada noticia y cómo la titula.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const path = Astro.url.pathname;
const isActive = (p: string) => (p === '' ? path === href('') || path.startsWith(href('canarias/')) || path.startsWith(href('grupo/')) : path.startsWith(href(p)));
const nav = [
  { p: '', label: 'Portada' },
  { p: 'medios/', label: 'Medios' },
  { p: 'como-funciona/', label: 'Cómo funciona' },
];
---
<!doctype html>
<html lang="es" data-base={href('')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0e1013" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreaderLatin} crossorigin />
    <link rel="manifest" href={href('manifest.webmanifest')} />
    <link rel="icon" href={href('icons/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('icons/apple-touch-icon.png')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <script is:inline>
      try { var t = localStorage.getItem('prisma-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen">
    <a href="#contenido" class="skip">Saltar al contenido</a>
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 py-3">
        <a href={href('')} class="order-1 flex items-center gap-2 text-ink no-underline" aria-label="Prisma, ir a la portada">
          <Logo size={30} /><span class="headline text-2xl">Prisma</span>
        </a>
        <div class="contents">
          <nav aria-label="Principal" class="order-3 -mx-3 flex w-full items-center text-sm sm:order-2 sm:mx-0 sm:w-auto">
            {nav.map((n) => (
              <a href={href(n.p)} aria-current={isActive(n.p) ? 'page' : undefined}
                 class={`rounded-full px-3 py-1.5 ${isActive(n.p) ? 'text-ink font-semibold' : 'text-muted hover:text-ink'}`}>{n.label}</a>
            ))}
          </nav>
          <button id="theme-toggle" type="button" class="order-2 grid h-9 w-9 place-items-center sm:order-3 sm:ml-1 rounded-full border border-line text-muted hover:text-ink" aria-label="Cambiar tema: automático, claro u oscuro" title="Cambiar tema">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="border-t border-line">
      <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-muted">
        <p class="max-w-2xl">Prisma no valora ni etiqueta a los medios: solo muestra quién cubre qué y cómo lo titula. Los titulares, resúmenes e imágenes pertenecen a sus medios, y cada enlace lleva al artículo original.</p>
        <p class="mt-2">{data.sources.length} medios · <a class="underline" href={href('como-funciona/')}>Metodología y límites</a> · <a class="underline" href="https://github.com/xacoy/PrismaNews">Código</a></p>
      </div>
    </footer>
    <script>
      import '../scripts/client';
    </script>
  </body>
</html>
